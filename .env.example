# Example environment configuration
# Copy to .env and customize for local development

# Data source
DATA_SOURCE=csv

# Timezone for session normalization
TIMEZONE=America/Chicago

# Example feature windows (in bars)
FEATURE_WINDOW_FAST=10
FEATURE_WINDOW_SLOW=20
FEATURE_WINDOW_VOLATILITY=20

# Example position size (demo only, not realistic)
DEMO_POSITION_SIZE=1.0
